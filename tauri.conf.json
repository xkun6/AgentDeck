{
  "$schema": "https://raw.githubusercontent.com/nicegoodthings/tauri-schema/main/tauri.conf.schema.json",
  "productName": "AgentDeck",
  "version": "0.3.13",
  "identifier": "local.agentdeck.desktop",
  "build": {
    "beforeDevCommand": "pnpm run tauri:before-dev",
    "beforeBuildCommand": "pnpm run tauri:before-build",
    "devUrl": "http://localhost:9545",
    "frontendDist": "./web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc://localhost http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://127.0.0.1:* wss://127.0.0.1:* ws://localhost:* wss://localhost:*; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; frame-src 'self' http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AgentDeck Contributors",
    "copyright": "Copyright © 2026 AgentDeck Contributors",
    "category": "DeveloperTool",
    "shortDescription": "AgentDeck multi-agent desktop",
    "longDescription": "AgentDeck: a desktop app for orchestrating locally installed coding agents.",
    "licenseFile": "legal/EULA.zh-CN.rtf",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "LICENSE": "LICENSE",
      "NOTICE.md": "NOTICE.md",
      "legal/paseo.Apache-2.0.txt": "paseo.Apache-2.0.txt",
      "legal/hermes-agent-upstream.MIT.txt": "hermes-agent-upstream.MIT.txt",
      "legal/liveagent.MIT.txt": "liveagent.MIT.txt",
      "legal/nodejs.LICENSE.txt": "nodejs.LICENSE.txt",
      "legal/sidecar-third-party.txt": "sidecar-third-party.txt",
      "legal/web-third-party.txt": "web-third-party.txt",
      "dist-sidecar/bundle.mjs": "sidecar/bundle.mjs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "customLanguageFiles": {
          "SimpChinese": "installer/nsis/SimpChinese.nsh"
        },
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
